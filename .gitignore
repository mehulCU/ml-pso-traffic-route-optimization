# Secrets
.env
.env.*
!.env.example

# Python cache and virtual environments
__pycache__/
*.py[cod]
.venv/
venv/
env/

# macOS
.DS_Store

# Large raw datasets
traffic_all.csv
traffic_test.csv
probe_counts/
geojson/

# Preserve required runtime data
# ml/candidate_region_edges.csv
